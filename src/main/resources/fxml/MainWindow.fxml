<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.diplomfacecontroller.MainController">

    <top>
        <VBox style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <!-- Ряд 1: камеры и калибровка -->
            <HBox spacing="4" style="-fx-padding: 4 6 2 6; -fx-background-color: #f0f0f0;" alignment="CENTER_LEFT">
                <Label text="Камеры:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                <Button fx:id="startButton" text="▶ Старт" onAction="#startTracking" style="-fx-font-size: 11;"/>
                <Button fx:id="stopButton" text="■ Стоп" onAction="#stopTracking" style="-fx-font-size: 11;"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="calibrationButton" text="⊕ Калибровка" onAction="#startCalibration" style="-fx-font-size: 11;"/>
                <Button fx:id="toggleMouseButton" text="👁 Взгляд: ВЫКЛ" onAction="#toggleMouseControl" style="-fx-font-size: 11;"/>
                <Button fx:id="resetMouseButton" text="⌖ Центр" onAction="#resetMousePosition" style="-fx-font-size: 11;"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Статус:" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                <Label fx:id="statusLabel" text="Готов" style="-fx-font-size: 11;"/>
            </HBox>
            <!-- Ряд 2: клавиатура и текст -->
            <HBox spacing="4" style="-fx-padding: 2 6 4 6; -fx-background-color: #e8e8e8;" alignment="CENTER_LEFT">
                <Label text="Клавиатура:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                <Button text="⌨ Показать/скрыть" onAction="#toggleKeyboard" style="-fx-font-size: 11;"/>
                <Button text="⇄ Режим вывода" onAction="#toggleKeyboardOutputMode" style="-fx-font-size: 11;"/>
                <Button text="⎘ Копировать" onAction="#copyText" style="-fx-font-size: 11;"/>
                <Button text="✕ Очистить" onAction="#clearText" style="-fx-font-size: 11;"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Набрано:" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                <Label fx:id="textOutputLabel" text="" style="-fx-border-color: #999; -fx-border-width: 1; -fx-padding: 2 4 2 4; -fx-background-color: white; -fx-font-size: 11;" prefWidth="350" minWidth="100"/>
                <Button text="Настройки" onAction="#openSettings" style="-fx-font-size: 10;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="4">
            <padding>
                <Insets top="4" right="4" bottom="4" left="4"/>
            </padding>

            <!-- Видео -->
            <HBox spacing="5" alignment="CENTER">
                <VBox spacing="2" alignment="CENTER">
                    <Label text="Камера лица (ID 1)" style="-fx-font-weight: bold; -fx-font-size: 10;"/>
                    <StackPane fx:id="camera1Container" style="-fx-border-color: #cccccc; -fx-border-width: 2; -fx-background-color: #000000;"
                               prefWidth="320" prefHeight="240"/>
                </VBox>
                <VBox spacing="2" alignment="CENTER">
                    <Label text="Камера глаз (ID 0)" style="-fx-font-weight: bold; -fx-font-size: 10;"/>
                    <StackPane fx:id="camera2Container" style="-fx-border-color: #cccccc; -fx-border-width: 2; -fx-background-color: #000000;"
                               prefWidth="160" prefHeight="120"/>
                </VBox>
                <!-- Информация справа -->
                <VBox spacing="4" style="-fx-padding: 6; -fx-border-color: #dddddd; -fx-border-width: 1; -fx-background-color: #fafafa;" alignment="TOP_LEFT">
                    <Label text="Голова:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                    <Label fx:id="headPoseLabel" text="0° | 0° | 0°" style="-fx-font-size: 11;"/>
                    <Label text="Взгляд:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                    <Label fx:id="gazeLabel" text="X:0 Y:0" style="-fx-font-size: 11;"/>
                    <Label text="Мимика:" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                    <Label fx:id="expressionLabel" text="Нейтрально" style="-fx-font-size: 11;"/>
                </VBox>
            </HBox>

            <!-- Клавиатура -->
            <VBox fx:id="keyboardContainer" alignment="CENTER">
                <Label text="⬆ Брови = подтверждение клавиши  |  Наведите взгляд и поднимите брови"
                       style="-fx-font-style: italic; -fx-font-size: 10; -fx-text-fill: #555;"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="5">
            <padding>
                <Insets bottom="3" right="8"/>
            </padding>
            <Label text="FaceController v1.0" style="-fx-text-fill: #888; -fx-font-size: 10;"/>
        </HBox>
    </bottom>

</BorderPane>
