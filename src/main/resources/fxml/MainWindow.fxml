<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.diplomfacecontroller.MainController">

    <!-- Верхняя панель с заголовком и кнопками (без изменений) -->
    <top>
        <VBox>
            <ToolBar>
                <Label text="FaceController - Управление компьютером взглядом" style="-fx-font-size: 14; -fx-font-weight: bold;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Button text="Настройки" onAction="#openSettings" />
                <Button fx:id="calibrationButton" text="Калибровка" onAction="#startCalibration" />
                <Separator orientation="VERTICAL" />
                <Button text="Старт" styleClass="action-button" onAction="#startTracking" />
                <Button text="Стоп" styleClass="action-button" onAction="#stopTracking" />
                <Separator orientation="VERTICAL" />
                <Button text="Клавиатура" onAction="#toggleKeyboard" />
                <Button text="Копировать" onAction="#copyText" />
                <Button text="Очистить" onAction="#clearText" />
            </ToolBar>
        </VBox>
    </top>

    <!-- Центральная область с видео и клавиатурой (все размеры уменьшены) -->
    <center>
        <VBox spacing="5">
            <padding>
                <Insets top="5" right="5" bottom="5" left="5" />
            </padding>

            <!-- Видео от камер (уменьшенные контейнеры) -->
            <HBox spacing="5" alignment="CENTER">
                <!-- Камера 1 - лицо -->
                <VBox spacing="3" alignment="CENTER">
                    <Label text="Камера 1 - Лицо" style="-fx-font-weight: bold; -fx-font-size: 11;" />
                    <StackPane fx:id="camera1Container" style="-fx-border-color: #cccccc; -fx-border-width: 2; -fx-background-color: #000000;"
                               prefWidth="320" prefHeight="240" />
                </VBox>

                <!-- Камера 2 - глаза -->
                <VBox spacing="3" alignment="CENTER">
                    <Label text="Камера 2 - Глаза" style="-fx-font-weight: bold; -fx-font-size: 11;" />
                    <StackPane fx:id="camera2Container" style="-fx-border-color: #cccccc; -fx-border-width: 2; -fx-background-color: #000000;"
                               prefWidth="160" prefHeight="120" />
                </VBox>
            </HBox>

            <!-- Информационная панель (уменьшены отступы) -->
            <GridPane hgap="10" vgap="2" alignment="CENTER" style="-fx-padding: 5; -fx-border-color: #dddddd; -fx-border-width: 1;">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                </columnConstraints>

                <Label text="Статус:" style="-fx-font-weight: bold; -fx-font-size: 11;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="statusLabel" text="Готов к работе" style="-fx-font-size: 11;" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <Label text="Голова:" style="-fx-font-weight: bold; -fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label fx:id="headPoseLabel" text="0° | 0° | 0°" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Взгляд:" style="-fx-font-weight: bold; -fx-font-size: 11;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label fx:id="gazeLabel" text="X:0 Y:0" style="-fx-font-size: 11;" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                <Label text="Мимика:" style="-fx-font-weight: bold; -fx-font-size: 11;" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                <Label fx:id="expressionLabel" text="Нейтрально" style="-fx-font-size: 11;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </GridPane>

            <!-- Контейнер для клавиатуры (без растяжения по высоте) -->
            <VBox fx:id="keyboardContainer" alignment="CENTER">
                <Label text="Виртуальная клавиатура (наведите взгляд на 0.8 сек для нажатия)" style="-fx-font-style: italic; -fx-font-size: 10;" />
                <!-- Canvas для клавиатуры будет добавлен программно -->
            </VBox>

            <!-- Вывод текста (ширина уменьшена для компактности) -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Набранный текст:" style="-fx-font-weight: bold; -fx-font-size: 11;" />
                <Label fx:id="textOutputLabel" text="" style="-fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 3; -fx-font-size: 11;" prefWidth="400" />
            </HBox>
        </VBox>
    </center>

    <!-- Нижняя панель (без изменений) -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="5">
            <padding>
                <Insets bottom="5" right="10" />
            </padding>
            <Label text="FaceController v1.0" style="-fx-text-fill: #666666; -fx-font-size: 10;" />
        </HBox>
    </bottom>

</BorderPane>